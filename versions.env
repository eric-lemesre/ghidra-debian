# Versions épinglées — une seule source pour build.sh et la CI. La version
# Debian vient de debian/changelog (build.sh vérifie qu'elle porte bien
# GHIDRA_VERSION) ; celle de Gradle est dans debian/rules, pour que le paquet
# source se construise seul. tools/nouvelle-version.sh met tout à jour.
GHIDRA_VERSION=12.1.4
GHIDRA_TAG=Ghidra_12.1.4_build
GHIDRA_UPSTREAM=https://github.com/NationalSecurityAgency/ghidra
# Somme de l'archive du tag, qui devient ghidra_<version>.orig.tar.gz.
GHIDRA_SRC_SHA256=2a858300c350f05ae2e729dff86b4f584d0b9a6b398879c55025574e67696cec
# Image de construction : Debian stable. Le paquet s'installe sur trixie et
# sur les versions suivantes.
BUILD_IMAGE=debian:trixie
